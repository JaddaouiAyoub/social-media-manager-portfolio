# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public URL of the deployed site (used for canonical URLs, Open Graph and the sitemap).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery through Resend (https://resend.com).
# All three values are required; otherwise the form clearly reports that
# online messaging is not available and no message is sent.
RESEND_API_KEY=
# Inbox that receives the messages.
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Portfolio <contact@your-domain.com>".
CONTACT_FROM_EMAIL=
